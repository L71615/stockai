# ============================================================
# StockAI — 环境变量配置
# 复制此文件为 .env
#   cp .env.example .env
# ============================================================

# --- 运行环境（必须）---
ENV=production
PORT=3000

# --- 管理员账号（必须修改）---
# 不开放注册，启动时自动创建此账号
ADMIN_EMAIL=admin@stockai.com
ADMIN_PASSWORD=请改成你自己的密码

# --- 安全（必须设置）---
# 生产环境必须设置，用 openssl rand -hex 32 生成
JWT_SECRET=
# 加密主密钥，用于加密存储的 AI Key、SMTP 密码等敏感数据
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
# JWT 令牌有效期（秒），默认 7200（2 小时）
JWT_EXPIRES=7200

# --- CORS（必须设置）---
# 允许访问的前端域名，逗号分隔
CORS_ORIGINS=http://localhost:3001,https://your-domain.com

# --- 数据源 Token（必须设置）---
# 东方财富 Token（从浏览器抓包获取）
EASTMONEY_TOKEN=

# --- AI 供应商（可选）---
# 所有 AI Key 都可以在网页"设置"页填入，存在数据库里
# 这里填的只是服务启动时的兜底值，不填不影响使用
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
XIAOMI_API_KEY=

# --- 邮件通知（可选）---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- v5.0-beta M6 分钟级 K 线（默认关闭）---
# true:  从 futu_raw_kline 读 1m bar（qfq 前复权）
# false: 从 historical_kline 读日级（v5.0-alpha 行为）
# 启用前需先确保 run_intraday_sync() 已运行 ≥1 个周期
REALTIME_USE_MINUTE_BARS=false
